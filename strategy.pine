// --- 3. INFERENCE & EXECUTION ---
float baseline = -0.18344085
float raw_margin = baseline + calc_chunk_0() + calc_chunk_1() + calc_chunk_2() + calc_chunk_3() + calc_chunk_4() + calc_chunk_5() + calc_chunk_6() + calc_chunk_7() + calc_chunk_8() + calc_chunk_9()
float prob = 1.0 / (1.0 + math.exp(-raw_margin))

input_threshold = input.float(0.55, 'Buy Probability Threshold', minval=0.50, maxval=0.95, step=0.01)
exit_threshold  = input.float(0.45, 'Exit/Sell Probability Threshold', minval=0.10, maxval=0.50, step=0.01)

long_condition  = prob >= input_threshold and barstate.isconfirmed
exit_condition  = prob <= exit_threshold and barstate.isconfirmed

if (long_condition)
    strategy.entry("Long", strategy.long)
if (exit_condition)
    strategy.close("Long")

plot(prob, "Model Probability", color=color.purple, display=display.pane)
hline(0.5, "Neutral", color=color.gray, linestyle=hline.style_dashed)